# ── Supabase (client-safe — bundled into the app) ───────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ── RevenueCat (client-safe — bundled into the app) ──────────────
# Get your API keys from: https://app.revenuecat.com/settings/api-keys
EXPO_PUBLIC_REVENUECAT_IOS_KEY=your-ios-api-key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=your-android-api-key

# ── Supabase (server-side only — NEVER prefix with EXPO_PUBLIC_) ─
# Used by seed scripts, Edge Functions, and CI tooling.
# SUPABASE_SECRET_KEY=your-secret-key

# ── Sentry (client-safe — bundled into the app) ──────────────────
# Get your DSN from: https://sentry.io/settings/projects/your-project/keys/
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn-here

# ── Google Maps (client-safe, restrict this key to the Android app) ─
# Required for pasture maps in Android builds. iOS uses Apple Maps by default.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=your-android-maps-api-key
